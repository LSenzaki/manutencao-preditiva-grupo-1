flowchart LR
    user["Usuário / Swagger UI"]

    subgraph compose["docker-compose"]
        subgraph backend["backend - Spring Boot :8080"]
            ctrl["PredicaoController"]
            val{"Bean Validation"}
            svc["PredicaoService"]
            repo["PredicaoRepository - JPA"]
            cli["MlClient - ProcessBuilder"]
            pred["ml/predict.py"]
            model[("modelo.pkl")]
        end

        db[("PostgreSQL :5432 - tabela predicao")]
    end

    err["400 Bad Request"]

    user -->|"POST /api/predicoes"| ctrl
    ctrl --> val
    val -->|"inválido"| err
    val -->|"válido"| svc
    svc --> cli
    cli -->|"python predict.py args - stdout JSON"| pred
    pred --> model
    svc --> repo
    repo -->|"JDBC"| db
    svc -->|"201 + probabilidade e risco"| user
